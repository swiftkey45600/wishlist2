# Generate a unique value with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
DATABASE_PATH=wishlist.db
UPLOAD_DIR=uploads/images
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional email delivery. Use an app password, never the account password.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT=10
# SMTP_USE_SSL=false uses mandatory STARTTLS (usually port 587).

# Local API base for email confirmation links. On the server use:
# PUBLIC_API_URL=https://swishlist.duckdns.org/api
PUBLIC_API_URL=http://127.0.0.1:8000

# Enable only on the server after SMTP is configured. Users opt in via profile.
# Event dates are interpreted in the server's local time zone.
EVENT_REMINDERS_ENABLED=false

# Optional Yandex ID login. Register the exact redirect URI in Yandex OAuth.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:5173/auth/yandex
